# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่าได้ตามต้องการ
# ไฟล์นี้ถูก commit ขึ้น GitHub และเว็บบน GitHub Pages / Docker ใช้ค่าในไฟล์นี้ตอน build (เพราะไม่มี .env)
# บัญชีทดลองสำหรับหน้า login (ชื่อผู้ใช้ = อีเมล)
# ค่าที่ขึ้นต้นด้วย VITE_ จะถูกฝังลงในเว็บตอน build ใครเปิดเว็บก็อ่านได้ ห้ามใส่รหัสผ่านจริง

# นักจิตวิทยา (ดร. มนัสวี)
VITE_CLINICIAN_EMAIL=manatsawee@mindlink.demo
VITE_CLINICIAN_PASSWORD=mindlink

# ผู้เข้ารับคำปรึกษา 1 (คุณเอ)
VITE_PATIENT_1_EMAIL=khun.a@mindlink.demo
VITE_PATIENT_1_PASSWORD=mindlink

# ผู้เข้ารับคำปรึกษา 2 (คุณชิน)
VITE_PATIENT_2_EMAIL=khun.chin@mindlink.demo
VITE_PATIENT_2_PASSWORD=mindlink

# ผู้เข้ารับคำปรึกษา 3 (คุณนนท์)
VITE_PATIENT_3_EMAIL=khun.non@mindlink.demo
VITE_PATIENT_3_PASSWORD=mindlink

# ผู้เข้ารับคำปรึกษา 4 (คุณพิม)
VITE_PATIENT_4_EMAIL=khun.pim@mindlink.demo
VITE_PATIENT_4_PASSWORD=mindlink

# --- Backend -----------------------------------------------------------------------------------------------------
# เว้นว่างไว้ = ใช้ mock ในเบราว์เซอร์ (localStorage) ไม่ต้องมี server
# ใส่ URL = เรียก REST API จริง (ดูรายการ endpoint ใน src/api/contract.ts)
VITE_API_URL=
# ตอนพัฒนา: ตั้ง VITE_API_URL=/api แล้วใส่ที่อยู่ backend ตรงนี้ dev server จะส่งต่อ /api/* ให้ (ไม่ต้องตั้ง CORS)
# API_PROXY_TARGET=http://localhost:3000
